{
  "name": "pokelearn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/server.test.mjs tests/policy.test.mjs tests/sprite-cache.test.mjs",
    "test:ui": "node tests/browser.mjs && node tests/v3-errors.mjs",
    "test:pwa": "node tests/final-qa.mjs",
    "screenshots": "node tests/v3-capture.mjs",
    "test:v3": "node tests/v3-smoke.mjs && node tests/v3-voice.mjs",
    "screenshots:v3": "node tests/v3-capture.mjs",
    "test:animation": "node tests/v3-animation.mjs",
    "check:models": "node scripts/check-models.mjs",
    "test:backend": "node --test tests/backend.test.mjs",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "music-metadata": "12.0.0"
  }
}
