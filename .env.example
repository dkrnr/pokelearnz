# Server-only. Copy to ignored .env; never paste or commit populated values.
OPENROUTER_KEY=
VALSEA_KEY=
AI_PROVIDER=openrouter
# Ordered explicit free IDs. Run npm run check:models after changing this list.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Development: inherit existing account privacy options, no account modifications.
# strict requires no collection + zero retention and may leave no free endpoints.
AI_PRIVACY=account
DEMO_MODE=false
# At least 32 random characters. Keep private, stable and distinct from API keys.
RATE_LIMIT_SALT=
# Origin guard permits same-origin loopback development and HTTPS pokelearnz Netlify hosts only.
AI_DAILY_CAP=200
AI_IP_PER_MINUTE=8
PAUSE_AI=false
# Local loopback only. Omit for deployed environments (they use Netlify Blobs).
LOCAL_AI_LIMITS=memory

# Optional independent capacity; never place credentials in public files.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b
